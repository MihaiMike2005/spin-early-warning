# Python bytecode caches — regenerated on every run, never belong in history
__pycache__/
*.pyc

# Virtual environments — machine-specific, recreated from pyproject.toml
.venv/
venv/

# Packaging build artifacts (appear once we pip-install the project)
build/
dist/
*.egg-info/

# Test tooling caches
.pytest_cache/

# Jupyter's autosaves, next to every notebook it opens
.ipynb_checkpoints/

# Raw recordings from the AC PC — too big for git; data/sample/ holds the committed one
data/raw/

# Cached tables, rebuilt from data/raw/
data/processed/

# Out-of-fold scores, one file per CV run
results/cv/

# macOS Finder metadata
.DS_Store

# Planning notes — kept locally, not published
docs/
